# Firebase client configuration is currently defined in src/lib/firebase.ts.
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_ALLOWED_EMAIL=you@example.com
ALLOWED_EMAIL=you@example.com

# Groq powers processing, contextual guidance, transcription, and web research.
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_WEB_MODEL=groq/compound-mini

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. Never enable this in production.
DISABLE_API_AUTH=false
