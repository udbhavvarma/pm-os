# syntax=docker/dockerfile:1
# -------------------------------------------------------
# ECR-Optimised Dockerfile — pm-os (Next.js)
# -------------------------------------------------------
# Uses Next.js standalone output for a lean, self-contained image.
# Requires next.config.ts to have output: 'standalone'.
# -------------------------------------------------------

# ── Stage 1: Install ALL dependencies ──────────────────
# Node 22 (current LTS) is REQUIRED: firebase-admin@14 declares
# engines.node >=22 and fails to load on older majors. Keep deps, builder, and
# runner on the SAME major so the standalone server.js never runs on a different
# Node than it was built against.
FROM public.ecr.aws/docker/library/node:22-alpine AS deps

WORKDIR /app

# Install libc compat layer for native modules on Alpine
RUN apk add --no-cache libc6-compat

COPY package*.json ./
# Use npm ci for reproducible, locked installs
RUN npm ci

# ── Stage 2: Build Next.js ──────────────────────────────
FROM public.ecr.aws/docker/library/node:22-alpine AS builder

WORKDIR /app

# Bring in node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy all source files
COPY . .

# Disable Next.js telemetry in CI/build
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ── Stage 3: Production runner (minimal image) ──────────
FROM public.ecr.aws/docker/library/node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Non-root user for security (matches K8s best practice)
RUN addgroup --system --gid 1001 nodejs \
    && adduser  --system --uid 1001 nextjs

# Standalone bundle from builder (includes its own node_modules copy)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Static assets
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Public assets (CSV, images, etc.)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:3000/pm-os/healthcheck || exit 1

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]