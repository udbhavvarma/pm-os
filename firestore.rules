rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsWorkspace(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if ownsWorkspace(uid);
      allow delete: if false;
    }

    match /users/{uid}/captures/{captureId} {
      allow read, write: if ownsWorkspace(uid);
    }

    match /users/{uid}/actions/{actionId} {
      allow read, write: if ownsWorkspace(uid);
    }

    match /users/{uid}/items/{itemId} {
      allow read, write: if ownsWorkspace(uid);
    }

    match /users/{uid}/dailyStates/{dayId} {
      allow read, write: if ownsWorkspace(uid);
    }

    match /users/{uid}/activities/{activityId} {
      allow read, write: if ownsWorkspace(uid);
    }

    match /users/{uid}/diagnostics/{eventId} {
      allow read, write: if ownsWorkspace(uid);
    }
  }
}
